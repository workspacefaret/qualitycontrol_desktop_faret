<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pruebas autocontenidas (sin paquetes nuevos) del módulo Clasificación de Pallets. Enlazan el código real del backend
       (Handler, PermisosService, FaretApiClient) contra un servidor HTTP local simulado; datos 100% sintéticos, sin red ni producción.
       Ejecutar con `dotnet run` en esta carpeta. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Backend\Services\EntornoAislado.cs" />
    <Compile Include="..\..\src\Backend\Modules\ClasificacionPallets\ClasificacionPalletsHandler.cs" />
    <Compile Include="..\..\src\Backend\Services\PermisosService.cs" />
    <Compile Include="..\..\src\Backend\Services\FaretApi\FaretApiClient.cs" />
    <Compile Include="..\..\src\Backend\Services\FaretApi\FaretApiSettings.cs" />
  </ItemGroup>

</Project>

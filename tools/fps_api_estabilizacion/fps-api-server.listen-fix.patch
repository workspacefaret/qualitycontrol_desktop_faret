+// Express 5 entrega el error de listen (p. ej. EADDRINUSE) al callback: sin esto el proceso imprimia "corriendo"
+// y terminaba con codigo 0 (causa del bucle de reinicios de pm2). Ahora sale con codigo 1 y deja el motivo.
+app.listen(port, (err) => {
+  if (err) {
+    console.error(`FPS API no pudo escuchar en el puerto ${port}: ${err.message}`);
+    process.exit(1);
+  }
+  console.log(`FPS API corriendo en http://localhost:${port}`);
+});
